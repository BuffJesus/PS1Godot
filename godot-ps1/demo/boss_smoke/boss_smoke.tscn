[gd_scene load_steps=18 format=3]

; Boss-encounter smoke scene. Exercises every combat primitive landed
; in the 2026-05-19 RFC arc:
;   - PS1Stats (boss + player both have stat blocks)
;   - PS1HurtBox (boss head/body/legs with descending crit multipliers)
;   - Camera.LockOn (R3 toggles, fog-gate engages on entry)
;   - dodge i-frames + onDamage callback (player_combat + boss_brain)
;   - PS1MeshInstance.UVScrollSpeed (the fog wall mesh)
;
; Intentionally low-fi — placeholder cube meshes for the boss + avatar,
; no textures, no music. The scene tree + scripts are the demo; visuals
; are something to swap in later.

[ext_resource type="Script" uid="uid://b8ogc8krip2k" path="res://addons/ps1godot/nodes/PS1Scene.cs" id="1_scene"]
[ext_resource type="Script" uid="uid://dng0iofdw3dk7" path="res://addons/ps1godot/nodes/PS1MeshInstance.cs" id="2_mesh"]
[ext_resource type="Script" uid="uid://cfdlp12g2rtct" path="res://addons/ps1godot/nodes/PS1Player.cs" id="3_player"]
[ext_resource type="Script" uid="uid://bbl6b0g2qjisp" path="res://addons/ps1godot/nodes/PS1TriggerBox.cs" id="4_trigger"]
[ext_resource type="Script" uid="uid://bp1p1kqop2wwy" path="res://addons/ps1godot/nodes/PS1UICanvas.cs" id="5_uican"]
[ext_resource type="Script" uid="uid://c01mt2tth0oll" path="res://addons/ps1godot/nodes/PS1UIElement.cs" id="6_uiel"]
[ext_resource type="Script" uid="uid://dy1f8ojji0fj" path="res://addons/ps1godot/nodes/PS1HurtBox.cs" id="7_hurt"]
[ext_resource type="Resource" path="res://demo/boss_smoke/boss_stats.tres" id="8_boss_stats"]
[ext_resource type="Resource" path="res://demo/boss_smoke/player_stats.tres" id="9_player_stats"]
[ext_resource type="Material" path="res://demo/boss_smoke/preview_dim.tres" id="10_preview_mat"]
[ext_resource type="Script" uid="uid://fctvwq3jxihi" path="res://addons/ps1godot/nodes/PS1Sky.cs" id="11_sky"]
[ext_resource type="Texture2D" uid="uid://cgngyr38qan3b" path="res://assets/monitor/textures/sky_stars.png" id="12_sky_tex"]

[sub_resource type="PlaneMesh" id="floor_mesh"]
size = Vector2(30, 30)
subdivide_width = 8
subdivide_depth = 8

[sub_resource type="BoxMesh" id="cube_2"]
size = Vector3(2, 2, 2)

[sub_resource type="BoxMesh" id="cube_player"]
size = Vector3(0.8, 1.6, 0.8)

[sub_resource type="PlaneMesh" id="fog_plane"]
size = Vector2(6, 4)
orientation = 2

; --- Root scene ---

[node name="BossSmoke" type="Node3D"]
script = ExtResource("1_scene")
FogEnabled = true
FogColor = Color(0.10, 0.05, 0.12, 1)
FogDensity = 2
GteScaling = 4
PlayerHeight = 1.7
PlayerRadius = 0.3
MoveSpeed = 3
JumpHeight = 1.2
Gravity = 20

; --- Skybox ---
; Full-screen quad drawn behind the world OT (Crash/Spyro pattern).
; Using sky_stars.png as a placeholder dark-sky texture; swap in a
; thematic boss-arena sky asset later.

[node name="Sky" type="Node3D" parent="."]
script = ExtResource("11_sky")
Texture = ExtResource("12_sky_tex")
BitDepth = 0
Tint = Color(0.7, 0.55, 0.7, 1)

; --- Floor ---

[node name="Floor" type="MeshInstance3D" parent="."]
mesh = SubResource("floor_mesh")
material_override = ExtResource("10_preview_mat")
script = ExtResource("2_mesh")
Collision = 1
Tag = 0
VertexColorMode = 0
FlatColor = Color(0.18, 0.18, 0.22, 1)

; --- Player rig ---

[node name="Player" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 8)
script = ExtResource("3_player")
CameraMode = 0

[node name="Camera3D" type="Camera3D" parent="Player"]
; Over-the-shoulder rig: X = +0.5 (right shoulder), Y = +1.4 (slight
; head-height raise), Z = +3 (behind). Keeps the avatar in the
; lower-left third of frame so it doesn't block the boss / target.
; Runtime overrides the basis with player yaw, so only the local
; position (last three Transform3D fields) is consumed.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 1.4, 3)
fov = 72.0
near = 0.2
far = 60.0

[node name="Avatar" type="MeshInstance3D" parent="Player"]
mesh = SubResource("cube_player")
material_override = ExtResource("10_preview_mat")
script = ExtResource("2_mesh")
Collision = 0
Tag = 0
VertexColorMode = 0
FlatColor = Color(0.15, 0.40, 0.20, 1)
Stats = ExtResource("9_player_stats")
ScriptFile = "res://demo/scripts/boss_smoke_player.lua"

; --- Boss + hurtboxes ---

[node name="Boss" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -6)
mesh = SubResource("cube_2")
material_override = ExtResource("10_preview_mat")
script = ExtResource("2_mesh")
Collision = 1
Tag = 7
VertexColorMode = 0
FlatColor = Color(0.45, 0.10, 0.10, 1)
Stats = ExtResource("8_boss_stats")
ScriptFile = "res://demo/scripts/boss_smoke_brain.lua"

[node name="HeadHurtBox" type="Node3D" parent="Boss"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.8, 0)
script = ExtResource("7_hurt")
Size = Vector3(0.5, 0.3, 0.5)
DamageMultiplier = 200

[node name="BodyHurtBox" type="Node3D" parent="Boss"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
script = ExtResource("7_hurt")
Size = Vector3(0.8, 0.6, 0.5)
DamageMultiplier = 100

[node name="LegsHurtBox" type="Node3D" parent="Boss"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
script = ExtResource("7_hurt")
Size = Vector3(0.6, 0.4, 0.5)
DamageMultiplier = 50

; --- Fog gate (visual + trigger) ---

[node name="FogWall" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 2)
mesh = SubResource("fog_plane")
material_override = ExtResource("10_preview_mat")
script = ExtResource("2_mesh")
Collision = 0
Tag = 0
VertexColorMode = 0
FlatColor = Color(0.25, 0.22, 0.30, 1)
Translucent = true
UVScrollSpeed = Vector2(12, 8)

[node name="FogGateTrigger" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 2)
script = ExtResource("4_trigger")
Size = Vector3(3, 1.5, 0.3)
ScriptFile = "res://demo/scripts/boss_smoke_fog_gate.lua"

